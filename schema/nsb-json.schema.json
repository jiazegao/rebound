{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jiazegao/rebound/main/schema/nsb-json.schema.json",
  "title": "NSB-JSON 1.0",
  "description": "Science Bowl questions and game logs. Specification: docs/NSB-JSON.md. Objects may carry fields this version does not define (later 1.x versions add fields); consumers ignore them.",
  "type": "object",
  "required": ["nsbjson", "kind"],
  "properties": {
    "nsbjson": {
      "description": "Format version, \"MAJOR.MINOR\". This schema describes 1.0; any 1.x file is readable by a 1.0 consumer.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)$"
    },
    "kind": {
      "description": "What the file holds.",
      "enum": ["question-set", "questions", "game-log"]
    },
    "generator": {
      "description": "The program that wrote the file, e.g. \"Rebound\".",
      "type": "string"
    },
    "exportedAt": {
      "description": "When the file was written.",
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "question-set" } } },
      "then": { "$ref": "#/$defs/questionSetDoc" }
    },
    {
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "questions" } } },
      "then": { "$ref": "#/$defs/questionsDoc" }
    },
    {
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "game-log" } } },
      "then": { "$ref": "#/$defs/gameLogDoc" }
    }
  ],
  "$defs": {
    "questionSetDoc": {
      "description": "kind \"question-set\": one question set.",
      "type": "object",
      "required": ["set"],
      "properties": {
        "set": { "$ref": "#/$defs/questionSet" }
      }
    },
    "questionsDoc": {
      "description": "kind \"questions\": a flat list of questions, e.g. a team's written questions.",
      "type": "object",
      "required": ["title", "questions"],
      "properties": {
        "title": { "type": "string" },
        "credit": { "description": "Who wrote or published the questions.", "type": "string" },
        "license": { "description": "What others may do with the questions.", "type": "string" },
        "level": { "$ref": "#/$defs/level" },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
      }
    },
    "gameLogDoc": {
      "description": "kind \"game-log\": one game.",
      "type": "object",
      "required": ["game"],
      "properties": {
        "game": { "$ref": "#/$defs/gameLog" }
      }
    },

    "id": {
      "description": "A stable identifier: case-sensitive, no spaces, unique among objects of its type in the file.",
      "type": "string",
      "pattern": "^\\S+$"
    },
    "subject": {
      "description": "The six 2027 categories, then three legacy categories from older sets.",
      "enum": ["biology", "chemistry", "earth_space", "energy", "math", "physics", "general_science", "computer_science", "physical_science"]
    },
    "coreSubject": {
      "description": "One of the six 2027 categories.",
      "enum": ["biology", "chemistry", "earth_space", "energy", "math", "physics"]
    },
    "provider": {
      "description": "Where questions come from: doe (DOE sample sets), sbreader (SB Reader files), team (written or uploaded by a team), rebound (generated by Rebound), other.",
      "enum": ["doe", "sbreader", "team", "rebound", "other"]
    },
    "level": {
      "description": "HS: high school; MS: middle school.",
      "enum": ["HS", "MS"]
    },
    "letter": {
      "description": "Multiple choice letters.",
      "enum": ["W", "X", "Y", "Z"]
    },
    "url": {
      "description": "An absolute URL.",
      "type": "string",
      "format": "uri"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },

    "questionSet": {
      "type": "object",
      "required": ["id", "provider", "level", "title", "credit", "license", "rounds"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "e.g. \"doe-hs-17\"." },
        "provider": { "$ref": "#/$defs/provider" },
        "level": { "$ref": "#/$defs/level" },
        "title": { "type": "string", "description": "e.g. \"DOE High School Sample Set 17\"." },
        "year": { "type": "string", "description": "e.g. \"2022\", when the set comes from a given year's competitions." },
        "setNumber": { "type": "integer", "minimum": 1 },
        "sourcePage": { "$ref": "#/$defs/url", "description": "Page the set was published on." },
        "credit": { "type": "string", "description": "Credit line to show with the questions." },
        "license": { "type": "string", "description": "What others may do with the questions, in words." },
        "rounds": { "type": "array", "items": { "$ref": "#/$defs/round" } }
      }
    },
    "round": {
      "type": "object",
      "required": ["id", "label", "order", "pairs"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "e.g. \"doe-hs-17-r01\"." },
        "label": { "type": "string", "description": "e.g. \"Round 1\" or \"Round 1A\"." },
        "order": { "type": "integer", "minimum": 1, "description": "Position of the round in its set (1-based)." },
        "sourceUrl": { "$ref": "#/$defs/url", "description": "The original file, e.g. DOE's PDF." },
        "pairs": { "type": "array", "items": { "$ref": "#/$defs/questionPair" } }
      }
    },
    "questionPair": {
      "description": "A toss-up and the bonus that goes with it.",
      "type": "object",
      "required": ["number", "tossup"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "tossup": {
          "allOf": [{ "$ref": "#/$defs/question" }, { "type": "object", "properties": { "kind": { "const": "tossup" } } }]
        },
        "bonus": {
          "allOf": [{ "$ref": "#/$defs/question" }, { "type": "object", "properties": { "kind": { "const": "bonus" } } }]
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "kind", "number", "subject", "sourceCategory", "format", "stem", "answer", "accept", "reject", "answerRaw", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "e.g. \"doe-hs-17-r01-t01\" (toss-up 1) or \"doe-hs-17-r01-b01\" (bonus 1)." },
        "kind": { "enum": ["tossup", "bonus"] },
        "number": { "type": "integer", "minimum": 1, "description": "Question number within its round (1-based)." },
        "subject": { "$ref": "#/$defs/subject" },
        "sourceCategory": { "type": "string", "description": "Category exactly as printed in the source, e.g. \"EARTH SCIENCE\"." },
        "format": { "enum": ["short_answer", "multiple_choice"] },
        "stem": { "type": "string", "description": "Question text without the answer choices. Pronunciation guides in [brackets]." },
        "choices": { "$ref": "#/$defs/choices" },
        "answer": { "type": "string", "description": "Main answer as printed; for multiple choice, the text of the correct choice." },
        "answerLetter": { "$ref": "#/$defs/letter", "description": "For multiple choice: the correct letter." },
        "accept": { "type": "array", "items": { "type": "string" }, "description": "Other acceptable answers (ACCEPT: ...)." },
        "reject": { "type": "array", "items": { "type": "string" }, "description": "Answers to reject (DO NOT ACCEPT: ...)." },
        "answerRaw": { "type": "string", "description": "The complete answer line as printed, without \"ANSWER:\"." },
        "notes": { "type": "array", "items": { "type": "string" }, "description": "Other instructions from the answer line, e.g. \"MUST GIVE BOTH ANSWERS\"." },
        "visual": { "type": "boolean", "description": "True when the question depends on a picture or figure." },
        "figure": { "$ref": "#/$defs/figure" },
        "source": { "$ref": "#/$defs/questionSource" },
        "flags": { "type": "array", "items": { "type": "string" }, "description": "Warnings raised while importing, e.g. \"choices-missing\"." },
        "topic": { "type": "string", "description": "Topic id, e.g. \"biology.genetics\"." },
        "concepts": { "type": "array", "items": { "type": "string" }, "description": "Concept ids within the topic." },
        "crossSubject": { "$ref": "#/$defs/coreSubject", "description": "For Energy questions: the discipline the question really tests." }
      }
    },
    "choices": {
      "description": "The four choices, without their letters.",
      "type": "object",
      "required": ["W", "X", "Y", "Z"],
      "properties": {
        "W": { "type": "string" },
        "X": { "type": "string" },
        "Y": { "type": "string" },
        "Z": { "type": "string" }
      },
      "additionalProperties": false
    },
    "figure": {
      "description": "A visual question's figure. Never insert \"svg\" from a file you did not generate yourself into a page as markup.",
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "svg", "alt"],
          "properties": {
            "kind": { "const": "svg" },
            "svg": { "type": "string", "description": "SVG markup." },
            "alt": { "type": "string", "description": "Text description of the figure." }
          }
        },
        {
          "type": "object",
          "required": ["kind", "src", "alt"],
          "properties": {
            "kind": { "const": "image" },
            "src": { "type": "string", "description": "A data: URL (JPEG, PNG or WebP, base64) or a path on the publishing site." },
            "alt": { "type": "string" },
            "credit": { "type": "string" },
            "sourceUrl": { "$ref": "#/$defs/url", "description": "Page the picture comes from." }
          }
        }
      ]
    },
    "questionSource": {
      "description": "Provenance of a question.",
      "type": "object",
      "required": ["provider", "setId", "roundId", "credit"],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "setId": { "type": "string", "description": "e.g. \"doe-hs-17\"." },
        "roundId": { "type": "string", "description": "e.g. \"doe-hs-17-r01\"." },
        "url": { "$ref": "#/$defs/url", "description": "Link to the original file." },
        "page": { "type": "integer", "minimum": 1, "description": "1-based page in the original file." },
        "credit": { "type": "string", "description": "Credit line to show with the question." }
      }
    },

    "gameLog": {
      "type": "object",
      "required": ["id", "createdAt", "updatedAt", "presetId", "season", "rules", "format", "packet", "pairs", "teams", "events", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" },
        "presetId": { "type": "string", "description": "Rules preset, e.g. \"doe-regional-2027\"." },
        "season": { "type": "string", "description": "Season of the rules, e.g. \"2027\"." },
        "rules": { "$ref": "#/$defs/gameRules" },
        "format": {
          "description": "\"tiebreak\": a tiebreaker drill that starts as a tiebreaker from 0-0 (no bonuses, no clock).",
          "enum": ["game", "tiebreak"]
        },
        "packet": { "$ref": "#/$defs/gamePacket" },
        "pairs": {
          "description": "The packet's questions in reading order; events refer to them by position (0-based).",
          "type": "array",
          "items": { "$ref": "#/$defs/gamePair" }
        },
        "teams": {
          "description": "The two teams and their starting lineups.",
          "type": "array",
          "items": { "$ref": "#/$defs/gameTeam" },
          "minItems": 2,
          "maxItems": 2
        },
        "players": {
          "description": "Display names for player ids, when included.",
          "type": "array",
          "items": { "$ref": "#/$defs/gamePlayer" }
        },
        "events": { "type": "array", "items": { "$ref": "#/$defs/matchEvent" } },
        "status": { "enum": ["in_progress", "finished"] },
        "finalScores": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "items": false,
          "minItems": 2
        }
      }
    },
    "gameRules": {
      "description": "The numbers the game was played under (a snapshot of the preset).",
      "type": "object",
      "required": ["name", "points", "interruptFaultMode", "timing", "visualBonus", "clock", "maxTossups", "tiebreakTossups"],
      "properties": {
        "name": { "type": "string" },
        "points": {
          "type": "object",
          "required": ["tossup", "bonus", "interruptFault"],
          "properties": {
            "tossup": { "type": "number" },
            "bonus": { "type": "number" },
            "interruptFault": { "type": "number", "description": "Points involved when a player faults on an interrupted toss-up." }
          }
        },
        "interruptFaultMode": {
          "description": "opponent_gains: the other team gains points.interruptFault (DOE Rule 6-2); interrupter_loses: the interrupting team loses them.",
          "enum": ["opponent_gains", "interrupter_loses"]
        },
        "timing": {
          "type": "object",
          "required": ["tossupWindowSec", "reboundWindowSec", "bonusSec", "bonusWarningAtSec", "naturalPauseSec"],
          "properties": {
            "tossupWindowSec": { "type": "number" },
            "reboundWindowSec": { "type": "number" },
            "bonusSec": { "type": "number" },
            "bonusWarningAtSec": { "type": "number" },
            "naturalPauseSec": { "type": "number" }
          }
        },
        "visualBonus": {
          "description": "Visual bonus answer window, or null for rules without visual bonuses.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["sec", "warningAtSec"],
              "properties": { "sec": { "type": "number" }, "warningAtSec": { "type": "number" } }
            }
          ]
        },
        "clock": {
          "description": "Game clock, or null for untimed play.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["halves", "halfMinutes", "breakMinutes"],
              "properties": {
                "halves": { "type": "integer", "minimum": 1 },
                "halfMinutes": { "type": "number" },
                "breakMinutes": { "type": "number" }
              }
            }
          ]
        },
        "maxTossups": {
          "description": "Most toss-ups in a game (virtual events stop at 18); null: play the whole packet.",
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
        },
        "tiebreakTossups": { "type": "integer", "minimum": 1, "description": "Toss-ups in a tiebreaker series." }
      }
    },
    "gamePacket": {
      "type": "object",
      "required": ["setId", "setTitle", "roundId", "roundLabel"],
      "properties": {
        "setId": { "type": "string" },
        "setTitle": { "type": "string" },
        "roundId": { "type": "string" },
        "roundLabel": { "type": "string" },
        "sourceUrl": { "$ref": "#/$defs/url" }
      }
    },
    "gamePair": {
      "type": "object",
      "required": ["tossupId", "subject"],
      "properties": {
        "tossupId": { "type": "string" },
        "bonusId": { "type": "string" },
        "subject": { "$ref": "#/$defs/subject", "description": "The toss-up's subject." }
      }
    },
    "gameTeam": {
      "type": "object",
      "required": ["name", "playerIds"],
      "properties": {
        "name": { "type": "string" },
        "playerIds": {
          "description": "Starting lineup, at most four players (Rule 8-1). Empty: not recorded, any player id may buzz.",
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 4
        }
      }
    },
    "gamePlayer": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "teamIndex": {
      "description": "0: the first team in \"teams\"; 1: the second.",
      "enum": [0, 1]
    },
    "matchEvent": {
      "description": "One event of the game log. t: time in milliseconds (Rebound writes Unix time); only differences between events matter, and t never decreases.",
      "type": "object",
      "required": ["type", "t"],
      "properties": {
        "type": {
          "enum": [
            "start",
            "tossup_read",
            "buzz",
            "tossup_judged",
            "tossup_dead",
            "bonus_read",
            "bonus_judged",
            "next",
            "throw_out",
            "clock_pause",
            "clock_resume",
            "time_expired",
            "start_half",
            "set_lineup",
            "start_tiebreak",
            "adjust_score",
            "end_game"
          ]
        },
        "t": { "type": "number" }
      },
      "allOf": [
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "buzz" } } },
          "then": {
            "type": "object",
            "required": ["team", "playerId"],
            "properties": { "team": { "$ref": "#/$defs/teamIndex" }, "playerId": { "type": "string" } }
          }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "tossup_judged" } } },
          "then": {
            "type": "object",
            "required": ["result"],
            "properties": { "result": { "enum": ["correct", "incorrect", "blurt", "stall", "communication"] } }
          }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "bonus_read" } } },
          "then": {
            "type": "object",
            "properties": { "visual": { "type": "boolean", "description": "A visual bonus (longer answer window)." } }
          }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "bonus_judged" } } },
          "then": {
            "type": "object",
            "required": ["result"],
            "properties": { "result": { "enum": ["correct", "incorrect", "timeout"] } }
          }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "throw_out" } } },
          "then": {
            "type": "object",
            "properties": { "note": { "type": "string" } }
          }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "set_lineup" } } },
          "then": {
            "type": "object",
            "required": ["team", "playerIds"],
            "properties": {
              "team": { "$ref": "#/$defs/teamIndex" },
              "playerIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 4 }
            }
          }
        },
        {
          "if": { "type": "object", "required": ["type"], "properties": { "type": { "const": "adjust_score" } } },
          "then": {
            "type": "object",
            "required": ["team", "delta", "note"],
            "properties": {
              "team": { "$ref": "#/$defs/teamIndex" },
              "delta": { "type": "number", "description": "Points added to the team (negative to take points away)." },
              "note": { "type": "string" }
            }
          }
        }
      ]
    }
  }
}
