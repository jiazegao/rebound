{
  "name": "rebound",
  "private": true,
  "version": "0.1.0",
  "description": "Rebound: a team-first study website for the National Science Bowl (unofficial).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "tsx scripts/doe/fetch.ts",
    "data:build": "tsx scripts/doe/build.ts",
    "data:fetch:ms": "tsx scripts/doe/fetch.ts --level ms",
    "data:build:ms": "tsx scripts/doe/build.ts --level ms",
    "data:fingerprints": "tsx scripts/studio/fingerprints.ts",
    "gen:profile": "tsx scripts/gen/profile.ts",
    "gen:check": "tsx scripts/gen/check.ts",
    "gen:search": "tsx scripts/gen/search.ts",
    "gen:key": "tsx scripts/gen/key.ts",
    "gen:trial:judge": "tsx scripts/gen/trials/judge.ts",
    "gen:trial:doe": "tsx scripts/gen/trials/doe.ts"
  },
  "dependencies": {
    "docx": "^9.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
