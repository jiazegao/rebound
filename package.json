{
  "name": "rebound",
  "private": true,
  "version": "0.1.0",
  "description": "Rebound: a team-first study website for the National Science Bowl (unofficial).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
